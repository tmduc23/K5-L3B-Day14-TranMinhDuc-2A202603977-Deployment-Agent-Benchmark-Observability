# ============================================================
# Biến môi trường agent cần (tiêu chí 9)
#
# Dùng:  cp .env.example .env    (.env đã nằm trong .gitignore)
# KHÔNG ghi secret thật vào file này — nó được commit lên Git.
# ============================================================

# ── Server ──
PORT=8000
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── Security — BẮT BUỘC ──
# Để trống thì agent từ chối mọi request (401), không phải mở cửa tự do.
# Sinh key:  openssl rand -hex 32
# Trên Railway/Render: đặt bằng biến môi trường của nền tảng, không commit.
AGENT_API_KEY=

# ── Redis — nơi lưu state rate limit và cost guard ──
# Chạy local:   redis://localhost:6379/0
# Qua Compose:  redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Rate limit — bảo vệ tốc độ ──
RATE_LIMIT_PER_MINUTE=10

# ── Cost guard — bảo vệ tiền ──
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0

# ── App metadata ──
APP_NAME=Production AI Agent
APP_VERSION=1.0.0
